{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shelf",
  "version": "0.3.0",
  "identifier": "com.shelf.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Shelf",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 420,
        "zoomHotkeysEnabled": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "A minimal, memory-first PDF reader",
    "longDescription": "Shelf is a minimal, memory-first PDF reader with AI lookup, annotations, and vocabulary memory.",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "Adobe Portable Document Format",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "publisher": "Bittu-the-coder",
    "copyright": "MIT License",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
