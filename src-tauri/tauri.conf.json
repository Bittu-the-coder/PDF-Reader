{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Reader",
  "version": "0.1.0",
  "identifier": "com.the-reader.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Reader",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
