{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shelf",
  "version": "0.2.0",
  "identifier": "com.shelf.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Shelf - PDF Reader",
        "width": 1100,
        "height": 750,
        "minWidth": 420,
        "minHeight": 380,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "A minimal, memory-first PDF reader",
    "longDescription": "Shelf is a minimal, memory-first PDF reader with AI lookup, annotations, and vocabulary memory.",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "Adobe Portable Document Format",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  }
}
